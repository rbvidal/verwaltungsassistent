# ─────────────────────────────────────────────────────────────
# Verwaltungsassistent — deployment configuration
#
# Copy to .env and adjust. All values are optional; the defaults
# match compose.yaml. The install scripts create this file for you.
# ─────────────────────────────────────────────────────────────

# ── Compose profiles ──
# local-ai  = Ollama runs inside Docker (models are downloaded on first start)
# (empty)   = use an external/host Ollama, then set OLLAMA_BASE_URL below
COMPOSE_PROFILES=local-ai

# ── Ports (host side) ──
APP_PORT=8081

# ── PostgreSQL ──
POSTGRES_DB=verwaltungsassistent
POSTGRES_USER=verwaltungsassistent
POSTGRES_PASSWORD=verwaltungsassistent

# ── Neo4j ──
NEO4J_PASSWORD=password

# ── Session/JWT signing key — change for anything beyond the demo ──
JWT_SECRET=demo-jwt-secret-that-is-at-least-32-bytes-long!!

# ── AI models (downloaded automatically when COMPOSE_PROFILES=local-ai) ──
# Larger models answer better but need a GPU; qwen2.5:7b is a lighter
# alternative for CPU-only hosts.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_VERIFIER_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m

# ── Demo behaviour ──
# true  = deterministic in-process demo seed on every start (fresh demo)
# false = keep the current database state; the restore script sets this
#         so the restored demo data set is preserved.
DEMO_STARTUP_RESET=true
LIVE_DEMO_ENABLED=false
INACTIVITY_TIMEOUT_MINUTES=6

# ── Linux only ──
# GID of the docker group, so the non-root app container may use the
# mounted Docker socket for the admin backup/restore feature.
# deploy/install-linux.sh detects and writes it (e.g. 999).
DOCKER_GID=0
