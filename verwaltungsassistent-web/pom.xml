<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>reasoning</groupId>
        <artifactId>verwaltungsassistent</artifactId>
        <version>1.0.0-RC2</version>
    </parent>

    <groupId>verwaltungsassistent.web</groupId>
    <artifactId>verwaltungsassistent-web</artifactId>
    <version>1.0.0-RC2</version>
    <packaging>jar</packaging>

    <name>Verwaltungsassistent Web</name>
    <description>Spring MVC + Thymeleaf + HTMX frontend for the Verwaltungsassistent</description>

    <properties>
        <java.version>21</java.version>
        <htmx.version>2.0.4</htmx.version>
        <alpinejs.version>3.14.9</alpinejs.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Thymeleaf Security Integration -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- Verwaltungsassistent Modules -->
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-auth</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-audit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-document-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-document-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-workspace</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-ai-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-ai-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-ai-ollama</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-search-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-search-qdrant</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>platform-neo4j</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-actuator</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Text extraction -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <!-- HTML/CSS to PDF for high-fidelity decision documents -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-core</artifactId>
            <version>1.0.10</version>
        </dependency>
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-svg-support</artifactId>
            <version>1.0.10</version>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Provider-neutraler Mailbox-Connector-Vertrag (eigenes Modul/JAR,
             Phase 2C.13): MailboxIngestionService & Co. haengen nur am API;
             die GreenMail-Implementierung lebt in dieser Anwendung. -->
        <dependency>
            <groupId>reasoning</groupId>
            <artifactId>mailbox-connector-api</artifactId>
        </dependency>

        <!-- Lokale Demo-Mailbox (GreenMail, Phase 2C.2): realer IMAP-Transport
             vor der bestehenden E-Mail-Pipeline — nur Demo/Test, kein
             Produktions-Postfach. GreenMail 2.1.x nutzt jakarta.mail (Boot 3.x). -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- HTMX and Alpine.js via WebJars -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>htmx.org</artifactId>
            <version>${htmx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>alpinejs</artifactId>
            <version>${alpinejs.version}</version>
        </dependency>
        <!-- Leaflet (BSD-2-Clause) for the Stadtkarte — served locally via WebJars, no external tiles -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>leaflet</artifactId>
            <version>1.9.4</version>
        </dependency>
        <!-- metadata-extractor (Apache-2.0) for EXIF/GPS extraction from uploaded photos -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.19.0</version>
        </dependency>
        <!-- Versionless /webjars/... URLs require the locator -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
